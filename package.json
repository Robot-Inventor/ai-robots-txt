{
  "name": "@robot-inventor/ai-robots-txt",
  "version": "0.15.0",
  "description": "ai.robots.txt for npm",
  "homepage": "https://github.com/Robot-Inventor/ai-robots-txt#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/ai-robots-txt/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/ai-robots-txt.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ./src ./scripts",
    "update": "node ./scripts/download.ts",
    "build": "tsc -p tsconfig.build.json",
    "ci:version": "changeset version",
    "ci:publish": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@robot-inventor/oxlint-config": "^1.0.0",
    "@robot-inventor/tsconfig-base": "^7.0.0",
    "@types/node": "^26.5.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.0"
  }
}
